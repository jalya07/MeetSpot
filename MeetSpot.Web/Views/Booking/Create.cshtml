@model MeetSpot.Web.Services.RoomResponseDto
@{
    ViewData["Title"] = "Book " + Model.Name;
}

<section class="booking-create">
    <div class="booking-create-inner">

        <div class="booking-room-summary">
            @if (Model.ImageUrls.Count > 0)
            {
                <img src="@Model.ImageUrls[0]" alt="@Model.Name" class="booking-room-photo" />
            }
            <div class="booking-room-info">
                <span class="room-type-badge room-type-@Model.Type.ToLower()">@Model.Type</span>
                <h2>@Model.Name</h2>
                <p class="booking-room-floor">Floor @Model.Floor · @Model.Capacity people max</p>
                <p class="booking-room-price">$@Model.PricePerHour / hour</p>

                @if (Model.Equipment.Any())
                {
                    <div class="equipment-list" style="margin-top: 14px;">
                        @foreach (var item in Model.Equipment)
                        {
                            <span class="equipment-tag">@item</span>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="booking-form-wrap">
            <h1>Book this room</h1>

            @if (ViewBag.Errors != null)
            {
                <div class="auth-errors">
                    @foreach (var error in ViewBag.Errors as List<string> ?? new())
                    {
                        <p>@error</p>
                    }
                </div>
            }

            <div id="bookingPromoBanner" style="display:none;background:#fef3c7;border:1px solid #f59e0b;border-radius:10px;padding:12px 16px;margin-bottom:16px;">
                <p id="bookingPromoText" style="color:#92400e;font-size:14px;font-weight:600;margin:0;"><i class="fas fa-bolt"></i> </p>
            </div>

            <form asp-action="Create" asp-route-id="@Model.Id" method="post" class="booking-form">
                <div class="form-group">
                    <label>Meeting title</label>
                    <input type="text" name="title" placeholder="e.g. Weekly team sync" required />
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Start time</label>
                        <input type="datetime-local" name="startTime" required
                            min="@DateTime.UtcNow.ToString("yyyy-MM-ddT08:00")"
                            max="@DateTime.UtcNow.AddDays(30).ToString("yyyy-MM-ddT18:00")" />
                    </div>
                    <div class="form-group">
                        <label>End time</label>
                        <input type="datetime-local" name="endTime" required
                            min="@DateTime.UtcNow.ToString("yyyy-MM-ddT08:00")"
                            max="@DateTime.UtcNow.AddDays(30).ToString("yyyy-MM-ddT18:00")" />
                    </div>
                </div>

                <div id="bookingPricePreview" style="display:none;flex-direction:column;gap:8px;background:var(--color-cream);border-radius:10px;padding:16px;margin-bottom:16px;">
                    <div id="bookingOriginalBlock" style="display:none;align-items:center;gap:8px;">
                        <span style="color:#6b7280;font-size:14px;">
                            Original: <span id="bookingOriginalPrice" style="text-decoration:line-through;">$0</span>
                        </span>
                        <span id="bookingDiscountBadge" style="background:var(--color-coral);color:white;padding:2px 10px;border-radius:20px;font-size:12px;font-weight:600;"></span>
                    </div>
                    <div style="display:flex;justify-content:space-between;align-items:center;">
                        <span style="font-weight:600;">Estimated total:</span>
                        <strong id="bookingEstimatedPrice" style="font-size:22px;color:var(--color-ink);">$0</strong>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary auth-submit">Confirm booking</button>
            </form>

            <p style="margin-top:16px;font-size:13px;color:#6b7280;text-align:center;">
                <a href="/Room/Details/@Model.Id">← Back to room details</a>
            </p>
        </div>
    </div>
</section>

<script>
    const pricePerHour = parseFloat('@Model.PricePerHour.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)');
    let activeDiscount = 0;

    fetch('/api/promotion')
        .then(r => r.json())
        .then(data => {
            if (data.data && data.data.length > 0) {
                const promo = data.data[0];
                activeDiscount = promo.discountPercent;
                document.getElementById('bookingPromoText').innerHTML =
                    `🎉 <b>${promo.title}</b> — ${promo.discountPercent}% off this booking! Valid until ${new Date(promo.endDate).toLocaleDateString('en-US', {month: 'short', day: 'numeric'})}`;
                document.getElementById('bookingPromoBanner').style.display = 'block';
                document.getElementById('bookingDiscountBadge').textContent = `-${promo.discountPercent}%`;
            }
        })
        .catch(() => {});

    function updatePrice() {
        const start = document.querySelector('[name="startTime"]').value;
        const end = document.querySelector('[name="endTime"]').value;

        if (start && end) {
            const hours = (new Date(end) - new Date(start)) / 3600000;
            if (hours > 0) {
                const originalPrice = hours * pricePerHour;
                const discountAmount = originalPrice * (activeDiscount / 100);
                const finalPrice = originalPrice - discountAmount;

                document.getElementById('bookingPricePreview').style.display = 'flex';
                document.getElementById('bookingEstimatedPrice').textContent = '$' + finalPrice.toFixed(2);

                if (activeDiscount > 0) {
                    document.getElementById('bookingOriginalBlock').style.display = 'flex';
                    document.getElementById('bookingOriginalPrice').textContent = '$' + originalPrice.toFixed(2);
                }
            }
        }
    }

    document.querySelector('[name="startTime"]').addEventListener('change', updatePrice);
    document.querySelector('[name="endTime"]').addEventListener('change', updatePrice);

    document.querySelector('form').addEventListener('submit', function(e) {
        const start = new Date(document.querySelector('[name="startTime"]').value);
        const end = new Date(document.querySelector('[name="endTime"]').value);

        if (start.getHours() < 8 || start.getHours() >= 18) {
            e.preventDefault();
            alert('Start time must be between 8:00 and 18:00');
            return;
        }

        if (end.getHours() > 18 || (end.getHours() === 18 && end.getMinutes() > 0)) {
            e.preventDefault();
            alert('End time must be by 18:00');
            return;
        }

        if (end <= start) {
            e.preventDefault();
            alert('End time must be after start time');
            return;
        }
    });
</script>
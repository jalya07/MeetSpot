@model List<MeetSpot.Web.Services.BlogPostDto>
@{
    ViewData["Title"] = "Blog";
}

<section class="blog-hero">
    <div class="blog-hero-content">
        <span class="hero-eyebrow" style="color:var(--color-coral);">Our blog</span>
        <h1>Insights & updates</h1>
        <p>Tips, news and stories from the MeetSpot team</p>
    </div>
</section>

<section class="blog-section">
    <div class="blog-inner">
        @if (Model.Any())
        {
            <div class="blog-grid">
                @foreach (var post in Model)
                {
                    <a href="/Blog/Details/@post.Id" class="blog-card">
                        @if (!string.IsNullOrEmpty(post.ImageUrl))
                        {
                            <div class="blog-card-image" style="background-image:url('@post.ImageUrl')"></div>
                        }
                        else
                        {
                            <div class="blog-card-image blog-card-placeholder"></div>
                        }
                        <div class="blog-card-body">
                            <p class="blog-card-date">@post.CreatedAt.ToString("MMM dd, yyyy")</p>
                            <h2 class="blog-card-title">@post.Title</h2>
                            <p class="blog-card-excerpt">
                                @(post.Content.Length > 120 ? post.Content.Substring(0, 120) + "..." : post.Content)
                            </p>
                            <div class="blog-card-author">
                                <div class="blog-author-avatar">@post.AuthorName.FirstOrDefault()</div>
                                <span>@post.AuthorName</span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="empty-catalog" style="text-align:center; padding:80px 0;">
                <p style="font-size:16px; color:var(--color-text-muted);">No blog posts yet. Check back soon!</p>
                <a href="/" class="btn btn-primary" style="margin-top:20px;">Go home</a>
            </div>
        }
    </div>
</section>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MeetSpot.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MeetSpot.Web.styles.css" asp-append-version="true" />
</head>
<body>
   <header class="site-header">
    <div class="top-bar">
        <div class="top-bar-inner">
            <span class="top-bar-tagline">Book a meeting room in seconds</span>
            <div class="top-bar-actions">
                <a href="#" class="top-bar-link">EN</a>
                 @if (ViewBag.IsLoggedIn == true)
                {
                    <span class="top-bar-link" style="color: rgba(255,255,255,0.85);">@ViewBag.FullName</span>
                    @if (ViewBag.UserRole == "Admin")
                    {
                        <a href="/Admin/Dashboard" class="top-bar-link">Admin panel</a>
                    }
                    <a href="/Dashboard" class="top-bar-link">My account</a>
                    <a href="/Account/Logout" class="top-bar-link top-bar-cta">Log out</a>
                }
                else
                {
                    <a href="/Account/Login" class="top-bar-link">Log in</a>
                    <a href="/Account/Register" class="top-bar-link top-bar-cta">Sign up</a>
                }
            </div>
        </div>
    </div>

    <nav class="main-nav">
        <button class="hamburger-btn" id="hamburgerBtn" aria-label="Open menu">
            <span></span><span></span><span></span>
        </button>

        <a href="/" class="brand">MeetSpot</a>

        <ul class="main-nav-links">
            <li><a href="/Room">Rooms</a></li>
            <li><a href="/Company">Companies</a></li>
            <li><a href="/Blog">Blog</a></li>
            <li><a href="/Home/About">About</a></li>
            <li><a href="/Home/Contact">Contact</a></li>
        </ul>
    </nav>

    <div class="mega-menu" id="megaMenu">
        <div class="mega-menu-overlay" id="megaMenuOverlay"></div>
        <div class="mega-menu-panel">
            <button class="mega-menu-close" id="megaMenuClose">×</button>
            <div class="mega-menu-columns">
                <div class="mega-menu-col">
                    <h4>Product</h4>
                    <a href="/Room">Browse rooms</a>
                    <a href="/Home/HowItWorks">How it works</a>
                    <a href="/Home/Pricing">Pricing</a>
                </div>
                <div class="mega-menu-col">
                    <h4>Solutions</h4>
                    <a href="/Home/Industries">Industries</a>
                    <a href="/Company">For companies</a>
                    <a href="/Home/Mentors">Mentors hub</a>
                </div>
                <div class="mega-menu-col">
                    <h4>Resources</h4>
                    <a href="/Blog">Blog</a>
                    <a href="/Home/Help">Help center</a>
                    <a href="/Home/About">About us</a>
                </div>
                <div class="mega-menu-col">
                    <h4>Account</h4>
                    <a href="/Account/Login">Log in</a>
                    <a href="/Account/Register">Sign up</a>
                    <a href="/Home/Contact">Contact us</a>
                </div>
            </div>
        </div>
    </div>
</header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

   <footer class="site-footer">
    <div class="footer-top">
        <div class="footer-brand-col">
            <span class="brand" style="color: var(--color-white);">MeetSpot</span>
            <p class="footer-tagline">Book the right meeting room in seconds — no chaos, no double-bookings.</p>
            <div class="footer-social">
                <a href="#" aria-label="LinkedIn">in</a>
                <a href="#" aria-label="Twitter">𝕏</a>
                <a href="#" aria-label="Instagram">ig</a>
            </div>
        </div>

        <div class="footer-col">
            <h4>Product</h4>
            <a href="/Room">Browse rooms</a>
            <a href="/Home/HowItWorks">How it works</a>
            <a href="/Home/Pricing">Pricing</a>
            <a href="/Company">For companies</a>
        </div>

        <div class="footer-col">
            <h4>Resources</h4>
            <a href="/Blog">Blog</a>
            <a href="/Home/Help">Help center</a>
            <a href="/Home/About">About us</a>
            <a href="/Home/Industries">Industries</a>
        </div>

        <div class="footer-col">
            <h4>Account</h4>
            <a href="/Account/Login">Log in</a>
            <a href="/Account/Register">Sign up</a>
            <a href="/Home/Contact">Contact us</a>
        </div>

        <div class="footer-col">
            <h4>Legal</h4>
            <a asp-controller="Home" asp-action="Privacy">Privacy policy</a>
            <a href="/Home/Terms">Terms of service</a>
            <a href="/Home/Refund">Refund policy</a>
        </div>
    </div>

    <div class="footer-bottom">
        <span>&copy; 2026 MeetSpot. All rights reserved.</span>
        <span class="footer-bottom-note">Built for Code Academy final project</span>
    </div>
</footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/home.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @await RenderSectionAsync("Styles", required: false)
</body>
</html>

@model List<MeetSpot.Web.Services.MentorDto>
@{
    ViewData["Title"] = "Mentors Hub";
}

<section class="mentors-hero">
    <div class="mentors-hero-content">
        <span class="hero-eyebrow" style="color:var(--color-coral);">Mentors Hub</span>
        <h1>Learn from the best in the industry</h1>
        <p>Book a private session with an experienced professional — in a MeetSpot room, face to face.</p>
        <div class="mentors-tags">
            <span class="mentor-tag active" data-filter="all">All</span>
            <span class="mentor-tag" data-filter=".NET">.NET</span>
            <span class="mentor-tag" data-filter="Product">Product</span>
            <span class="mentor-tag" data-filter="Design">Design</span>
            <span class="mentor-tag" data-filter="Data">Data</span>
            <span class="mentor-tag" data-filter="DevOps">DevOps</span>
        </div>
    </div>
</section>

<section class="mentors-section">
    <div class="mentors-inner">
        @if (Model.Any())
        {
            <div class="mentors-grid">
                @foreach (var mentor in Model)
                {
                    <div class="mentor-card" data-skills="@string.Join(",", mentor.Skills)">
                        <div class="mentor-card-top">
                            <div class="mentor-avatar" style="background:var(--color-ink);">
                                @if (!string.IsNullOrEmpty(mentor.AvatarUrl))
                                {
                                    <img src="@mentor.AvatarUrl" alt="@mentor.FullName"
                                         style="width:60px;height:60px;border-radius:50%;object-fit:cover;" />
                                }
                                else
                                {
                                    @mentor.FirstName[0].ToString().ToUpper()
                                }
                            </div>
                            <div class="mentor-rating">
                                @for (int i = 0; i < (int)mentor.Rating; i++)
                                {
                                    <span style="color:#F59E0B;">★</span>
                                }
                                @for (int i = (int)mentor.Rating; i < 5; i++)
                                {
                                    <span style="color:#E5E7EB;">★</span>
                                }
                            </div>
                        </div>

                        <h3 class="mentor-name">@mentor.FullName</h3>
                        <p class="mentor-role">@mentor.Role</p>
                        <p class="mentor-company"><i class="fas fa-building" style="color:var(--color-coral);margin-right:6px;"></i>@mentor.Company</p>
                        <p class="mentor-bio">@mentor.Bio</p>

                        <div class="mentor-skills">
                            @foreach (var skill in mentor.Skills)
                            {
                                <span class="mentor-skill-tag">@skill</span>
                            }
                        </div>

                        <div class="mentor-footer">
                            <span class="mentor-sessions">
                                <i class="fas fa-video" style="color:var(--color-coral);"></i>
                                @mentor.SessionsCount sessions
                            </span>
                            <a href="/Room" class="btn btn-primary" style="font-size:13px;padding:8px 16px;">
                                Book session
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-catalog" style="text-align:center;padding:60px;">
                <p style="font-size:18px;color:var(--color-text-muted);">No mentors available yet.</p>
                <p style="color:var(--color-text-muted);">Check back soon!</p>
            </div>
        }

        <div class="mentors-cta">
            <h2>Want to become a mentor?</h2>
            <p>Share your expertise with the next generation of professionals.</p>
            <a href="/Home/BecomeMentor" class="btn btn-primary">Apply to mentor</a>
        </div>
    </div>
</section>

@section Scripts {
<script>
    const tags = document.querySelectorAll('.mentor-tag');
    const cards = document.querySelectorAll('.mentor-card');

    tags.forEach(tag => {
        tag.addEventListener('click', function() {
            tags.forEach(t => t.classList.remove('active'));
            this.classList.add('active');

            const filter = this.dataset.filter;

            cards.forEach(card => {
                if (filter === 'all') {
                    card.style.display = 'flex';
                    return;
                }
                const skills = card.dataset.skills;
                card.style.display = skills.includes(filter) ? 'flex' : 'none';
            });
        });
    });
</script>
}

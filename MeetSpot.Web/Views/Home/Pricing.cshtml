@{
    ViewData["Title"] = "Pricing";
}

<section class="pricing-hero">
    <h1>Simple, transparent pricing</h1>
    <p>Choose the plan that works for your team</p>
</section>

<section class="pricing-section">
    <div class="pricing-grid">
        <div class="pricing-card">
            <div class="pricing-card-header">
                <h2>Regular</h2>
                <p class="pricing-desc">Perfect for individuals and small teams</p>
            </div>
            <div class="pricing-price">
                <span class="price-free">Free</span>
                <span class="price-sub">to sign up</span>
            </div>
            <ul class="pricing-features">
                <li><i class="fas fa-check"></i> Book standard rooms</li>
                <li><i class="fas fa-check"></i> Book 5 days in advance</li>
                <li><i class="fas fa-check"></i> Pay per booking from wallet</li>
                <li><i class="fas fa-check"></i> QR check-in</li>
                <li><i class="fas fa-times text-muted"></i> Same-day bookings</li>
                <li><i class="fas fa-times text-muted"></i> VIP room access</li>
            </ul>
            <a href="/Account/Register" class="btn btn-secondary pricing-btn">Get started free</a>
        </div>

        <div class="pricing-card pricing-card-featured">
            <div class="pricing-badge">Most popular</div>
            <div class="pricing-card-header">
                <h2>Premium</h2>
                <p class="pricing-desc">For power users who need flexibility</p>
            </div>
            <div class="pricing-price">
                <span class="price-amount">$19.99</span>
                <span class="price-sub">/month</span>
            </div>
            <ul class="pricing-features">
                <li><i class="fas fa-check"></i> All Standard rooms</li>
                <li><i class="fas fa-check"></i> Same-day bookings</li>
                <li><i class="fas fa-check"></i> VIP room access</li>
                <li><i class="fas fa-check"></i> Lower cancellation fees (25%)</li>
                <li><i class="fas fa-check"></i> QR check-in</li>
                <li><i class="fas fa-check"></i> Priority support</li>
            </ul>
            <a href="/Account/Register" class="btn btn-primary pricing-btn">Start Premium</a>
        </div>

        <div class="pricing-card">
            <div class="pricing-card-header">
                <h2>Corporate</h2>
                <p class="pricing-desc">For companies with multiple employees</p>
            </div>
            <div class="pricing-price">
                <span class="price-free">Custom</span>
                <span class="price-sub">contact us</span>
            </div>
            <ul class="pricing-features">
                <li><i class="fas fa-check"></i> All Premium features</li>
                <li><i class="fas fa-check"></i> No balance needed</li>
                <li><i class="fas fa-check"></i> Same-day bookings</li>
                <li><i class="fas fa-check"></i> Free cancellations</li>
                <li><i class="fas fa-check"></i> Company domain login</li>
                <li><i class="fas fa-check"></i> Dedicated account manager</li>
            </ul>
            <a href="/Home/Contact" class="btn btn-secondary pricing-btn">Contact sales</a>
        </div>
    </div>
</section>
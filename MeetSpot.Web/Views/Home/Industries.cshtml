@{ViewData["Title"] = "Industries";}
<section class="blog-hero">
    <div class="blog-hero-content">
        <span class="hero-eyebrow" style="color:var(--color-coral);">Industries</span>
        <h1>MeetSpot for every industry</h1>
        <p>From startups to enterprises — MeetSpot adapts to your team's needs</p>
    </div>
</section>
<section class="blog-section">
    <div class="blog-inner">
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;">
            @foreach (var industry in new[]{"Technology","Finance","Healthcare","Education","Legal","Media"})
            {
                <div style="background:var(--color-white);border:1px solid var(--color-border);border-radius:14px;padding:28px;text-align:center;">
                    <h3 style="font-size:18px;font-weight:600;color:var(--color-ink);margin-bottom:8px;">@industry</h3>
                    <p style="color:var(--color-text-muted);font-size:14px;">MeetSpot helps @industry teams book rooms faster and smarter.</p>
                </div>
            }
        </div>
    </div>
</section>
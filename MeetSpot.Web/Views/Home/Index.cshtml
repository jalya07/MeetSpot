@model List<MeetSpot.Web.Services.RoomResponseDto>
@{
    ViewData["Title"] = "MeetSpot — Book your meeting room";
}
@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
}

<section class="hero">
    <div class="hero-slideshow">
        <div class="hero-slide active" style="background-image: url('/images/hero/hero1.jpg')"></div>
        <div class="hero-slide" style="background-image: url('/images/hero/hero2.jpg')"></div>
        <div class="hero-slide" style="background-image: url('/images/hero/hero3.jpg')"></div>
        <div class="hero-slide" style="background-image: url('/images/hero/hero4.jpg')"></div>
        <div class="hero-slide" style="background-image: url('/images/hero/hero5.jpg')"></div>
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <span class="hero-eyebrow">Meeting rooms, on demand</span>
        <h1 class="hero-title">Find the right room.<br>Book it in seconds.</h1>
        <p class="hero-subtitle">
            MeetSpot connects you to available meeting spaces across the building —
            see what's free right now, reserve it, and walk in.
        </p>
        <div class="hero-actions">
            <a href="/Room" class="btn btn-primary">Browse rooms</a>
            <a href="/Account/Register" class="btn btn-secondary">Create account</a>
        </div>
    </div>
</section>

<section class="rooms-preview">
    <div class="section-header">
        <h2>Available right now</h2>
        <a href="/Room" class="see-all">See all rooms →</a>
    </div>

    <div class="rooms-filters">
        <button class="filter-btn active" data-filter="all">All rooms</button>
        <button class="filter-btn" data-filter="vip">Premium / VIP</button>
        <button class="filter-btn" data-filter="large">10+ people</button>
        <button class="filter-btn" data-filter="cheap">Under $20/hr</button>
    </div>

    @{
        var stats = ViewBag.Stats as MeetSpot.Web.Services.PublicStatsDto;
    }
    <div class="stats-grid">
        <div class="stat-box">
            <span class="stat-number">@(stats?.TotalBookings ?? 0)</span>
            <span class="stat-label">Bookings made</span>
        </div>
        <div class="stat-box">
            <span class="stat-number">@(stats?.TotalRooms ?? 0)</span>
            <span class="stat-label">Rooms available</span>
        </div>
        <div class="stat-box">
            <span class="stat-number">@(stats?.ActiveUsers ?? 0)</span>
            <span class="stat-label">Active members</span>
        </div>
        <div class="stat-box">
            <span class="stat-number">@(stats?.OccupancyRate ?? 0)%</span>
            <span class="stat-label">Average occupancy</span>
        </div>
    </div>
</section>

<section class="popularity-stats">
    <div class="section-header centered">
        <h2>Trusted across the building</h2>
        <p class="section-subtitle">Real numbers from real bookings</p>
    </div>

    <div class="stats-grid">
        <div class="stat-box">
            <span class="stat-number" id="statBookings">0</span>
            <span class="stat-label">Bookings made</span>
        </div>
        <div class="stat-box">
            <span class="stat-number" id="statRooms">0</span>
            <span class="stat-label">Rooms available</span>
        </div>
        <div class="stat-box">
            <span class="stat-number" id="statUsers">0</span>
            <span class="stat-label">Active members</span>
        </div>
        <div class="stat-box">
            <span class="stat-number" id="statOccupancy">0%</span>
            <span class="stat-label">Average occupancy</span>
        </div>
    </div>
</section>

<section class="how-it-works">
    <div class="section-header centered">
        <h2>How it works</h2>
        <p class="section-subtitle">Three simple steps from search to seat</p>
    </div>

    <div class="steps-grid">
        <div class="step-card">
            <span class="step-number">01</span>
            <h3>Find a room</h3>
            <p>Browse available spaces by date, time, capacity, or amenities — see what's free in real time.</p>
        </div>
        <div class="step-card">
            <span class="step-number">02</span>
            <h3>Book instantly</h3>
            <p>Reserve your spot in seconds. Get a QR code and confirmation sent straight to your inbox.</p>
        </div>
        <div class="step-card">
            <span class="step-number">03</span>
            <h3>Walk in and meet</h3>
            <p>Scan your QR at the door, and the room is yours. No waiting, no confusion.</p>
        </div>
    </div>
</section>
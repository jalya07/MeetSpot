@model List<MeetSpot.Web.Services.RoomResponseDto>
@{
    ViewData["Title"] = "MeetSpot — Book your meeting room";
}
@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
}

<section class="hero">
    <div class="hero-slideshow">
        <div class="hero-slide active" style="background-image: url('/images/hero/hero1.jpg')"></div>
        <div class="hero-slide" style="background-image: url('/images/hero/hero2.jpg')"></div>
        <div class="hero-slide" style="background-image: url('/images/hero/hero3.jpg')"></div>
        <div class="hero-slide" style="background-image: url('/images/hero/hero4.jpg')"></div>
        <div class="hero-slide" style="background-image: url('/images/hero/hero5.jpg')"></div>
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <span class="hero-eyebrow">Meeting rooms, on demand</span>
        <h1 class="hero-title">Find the right room.<br>Book it in seconds.</h1>
        <p class="hero-subtitle">
            MeetSpot connects you to available meeting spaces across the building —
            see what's free right now, reserve it, and walk in.
        </p>
        <div class="hero-actions">
            <a href="/Room" class="btn btn-primary">Browse rooms</a>
            <a href="/Account/Register" class="btn btn-secondary">Create account</a>
        </div>
    </div>
</section>

<section class="rooms-preview">
    <div class="section-header">
        <h2>Available right now</h2>
        <a href="/Room" class="see-all">See all rooms →</a>
    </div>

    <div class="rooms-filters">
        <button class="filter-btn active" data-filter="all">All rooms</button>
        <button class="filter-btn" data-filter="vip">Premium / VIP</button>
        <button class="filter-btn" data-filter="large">10+ people</button>
        <button class="filter-btn" data-filter="cheap">Under $20/hr</button>
    </div>

    <div class="rooms-grid" id="roomsGrid">
        @if (Model != null && Model.Any())
        {
            @foreach (var room in Model.Take(6))
            {
               <a href="/Room/Details/@room.Id" class="room-card"
                    data-type="@room.Type.ToLower()"
                    data-capacity="@room.Capacity"
                    data-price="@room.PricePerHour">
                    <div class="room-photo-wrap">
                        @if (room.ImageUrls.Count > 0)
                        {
                             <img class="room-photo room-photo-primary" src="@room.ImageUrls[0]" alt="@room.Name" />
                        @if (room.ImageUrls.Count > 1)
                        {
                            <img class="room-photo room-photo-secondary" src="@room.ImageUrls[1]" alt="@room.Name" />
                        }
                        }
                        else
                        {
                             <div class="room-photo-placeholder"></div>
                        }
                        <span class="room-type-badge room-type-@room.Type.ToLower()">@room.Type</span>
            </div>
            <div class="room-card-body">
                <div class="room-card-header">
                    <h3 class="room-name">@room.Name</h3>
                    <span class="room-floor">Floor @room.Floor</span>
                </div>
                <p class="room-description">@room.Description</p>
                <div class="room-meta">
                    <span class="room-capacity">@room.Capacity people</span>
                    <span class="room-price">$@room.PricePerHour/hr</span>
                </div>
            </div>
            </a>
            }
        }
        else
        {
            <p class="empty-state">No rooms available yet.</p>
        }
    </div>
</section>

<section class="popularity-stats">
    <div class="section-header centered">
        <h2>Trusted across the building</h2>
        <p class="section-subtitle">Real numbers from real bookings</p>
    </div>

    @{
        var stats = ViewBag.Stats as MeetSpot.Web.Services.PublicStatsDto;
    }
    <div class="stats-grid">
        <div class="stat-box">
            <span class="stat-number">@(stats?.TotalBookings ?? 0)</span>
            <span class="stat-label">Bookings made</span>
        </div>
        <div class="stat-box">
            <span class="stat-number">@(stats?.TotalRooms ?? 0)</span>
            <span class="stat-label">Rooms available</span>
        </div>
        <div class="stat-box">
            <span class="stat-number">@(stats?.ActiveUsers ?? 0)</span>
            <span class="stat-label">Active members</span>
        </div>
        <div class="stat-box">
            <span class="stat-number">@(stats?.OccupancyRate ?? 0)%</span>
            <span class="stat-label">Average occupancy</span>
        </div>
    </div>
</section>

<section class="how-it-works">
    <div class="section-header centered">
        <h2>How it works</h2>
        <p class="section-subtitle">Three simple steps from search to seat</p>
    </div>

    <div class="steps-grid">
        <div class="step-card">
            <span class="step-number">01</span>
            <h3>Find a room</h3>
            <p>Browse available spaces by date, time, capacity, or amenities — see what's free in real time.</p>
        </div>
        <div class="step-card">
            <span class="step-number">02</span>
            <h3>Book instantly</h3>
            <p>Reserve your spot in seconds. Get a QR code and confirmation sent straight to your inbox.</p>
        </div>
        <div class="step-card">
            <span class="step-number">03</span>
            <h3>Walk in and meet</h3>
            <p>Scan your QR at the door, and the room is yours. No waiting, no confusion.</p>
        </div>
    </div>
</section>
<section class="account-types">
    <div class="section-header centered">
        <h2>Plans and rooms for every team</h2>
        <p class="section-subtitle">Pick the plan that matches how you work</p>
    </div>

    <div class="offers-slider">
        <button class="slider-arrow slider-prev" id="offersPrev">←</button>

        <div class="offers-track" id="offersTrack">
            <div class="offer-card">
                <div class="offer-image" style="background-image: url('/images/hero/hero3.jpg')"></div>
                <div class="offer-content">
                    <span class="offer-badge">Regular</span>
                    <h3>Pay as you go</h3>
                    <p>Sign up free, top up your balance, and book any standard room. Perfect for individuals and small teams getting started.</p>
                    <ul class="offer-list">
                        <li>Book 5 days in advance</li>
                        <li>Standard rooms only</li>
                        <li>Pay-per-booking from your wallet</li>
                    </ul>
                </div>
            </div>

            <div class="offer-card">
                <div class="offer-image" style="background-image: url('/images/hero/hero2.jpg')"></div>
                <div class="offer-content">
                    <span class="offer-badge offer-badge-premium">Premium</span>
                    <h3>Skip the wait</h3>
                    <p>Upgrade for same-day bookings, VIP room access, and lower cancellation fees — ideal for fast-moving teams.</p>
                    <ul class="offer-list">
                        <li>Same-day bookings</li>
                        <li>Access to VIP rooms</li>
                        <li>Lower cancellation fees</li>
                    </ul>
                </div>
            </div>

            <div class="offer-card">
                <div class="offer-image" style="background-image: url('/images/hero/hero4.jpg')"></div>
                <div class="offer-content">
                    <span class="offer-badge offer-badge-corporate">Corporate</span>
                    <h3>Built for companies</h3>
                    <p>Your organization covers the bill. Employees book instantly with their work email — no balance, no friction.</p>
                    <ul class="offer-list">
                        <li>Same-day bookings, no balance needed</li>
                        <li>Full VIP access</li>
                        <li>Free cancellations</li>
                    </ul>
                </div>
            </div>
            <div class="offer-card">
                <div class="offer-image" style="background-image: url('/images/hero/hero1.jpg')"></div>
                <div class="offer-content">
                    <span class="offer-badge">Standard rooms</span>
                    <h3>Everyday meeting spaces</h3>
                    <p>Comfortable, well-equipped rooms for daily standups, calls, and team syncs at accessible prices.</p>
                    <ul class="offer-list">
                        <li>Whiteboards & TV screens</li>
                        <li>2 to 25 person capacity</li>
                        <li>Lower hourly rates</li>
                    </ul>
                </div>
            </div>
            <div class="offer-card">
                <div class="offer-image" style="background-image: url('/images/hero/hero5.jpg')"></div>
                <div class="offer-content">
                    <span class="offer-badge offer-badge-premium">VIP rooms</span>
                    <h3>Make an impression</h3>
                    <p>Premium spaces with skyline views, video conferencing, and climate control — for the meetings that matter.</p>
                    <ul class="offer-list">
                        <li>City views & premium furnishing</li>
                        <li>Full A/V equipment</li>
                        <li>Reserved for Premium & Corporate</li>
                    </ul>
                </div>
            </div>
        </div>
        <button class="slider-arrow slider-next" id="offersNext">→</button>
    </div>
</section>
<section class="use-cases">
    <div class="use-case-image" style="background-image: url('/images/hero/hero4.jpg')"></div>
    <div class="use-case-content">
        <span class="hero-eyebrow" style="color: var(--color-coral);">Why teams choose MeetSpot</span>
        <h2>From quick stand-ups to full-day events</h2>
        <p>
            Whether it's a five-minute sync between two engineers or a company-wide
            training session for fifty people, MeetSpot adapts. Teams use the platform
            to run client pitches, onboard new hires, host workshops, and organize
            entire conferences — all booked through the same simple flow.
        </p>
        <ul class="use-case-points">
            <li><strong>Daily meetings</strong> — standups, 1-on-1s, quick syncs</li>
            <li><strong>Training & workshops</strong> — equipped rooms for groups of any size</li>
            <li><strong>Events</strong> — book multiple rooms at once for conferences and offsites</li>
        </ul>
        <a href="/Room" class="btn btn-primary" style="display: inline-block; margin-top: 8px;">Explore rooms</a>
    </div>
</section>
@{
    var companies = ViewBag.Companies as List<MeetSpot.Web.Services.CompanyResponseDto>;
}
<section class="trusted-by">
    <div class="trusted-by-content">
        <div class="trusted-by-text">
            <span class="hero-eyebrow" style="color: var(--color-coral);">Trusted by teams</span>
            <h2>Companies that book with MeetSpot</h2>
            <p>From fast-growing startups to established corporations, teams rely on MeetSpot for their daily meeting needs.</p>
        </div>
        <div class="logo-columns">
            <div class="logo-column logo-column-up">
                @if (companies != null && companies.Any())
                {
                    @foreach (var company in companies)
                    {
                        <div class="logo-card">
                            @if (!string.IsNullOrEmpty(company.LogoUrl))
                            {
                                <img src="@company.LogoUrl" alt="@company.Name" />
                            }
                            else
                            {
                                <span class="company-name-fallback">@company.Name</span>
                            }
                        </div>
                    }
                    @foreach (var company in companies)
                    {
                        <div class="logo-card">
                            @if (!string.IsNullOrEmpty(company.LogoUrl))
                            {
                                <img src="@company.LogoUrl" alt="@company.Name" />
                            }
                            else
                            {
                                <span class="company-name-fallback">@company.Name</span>
                            }
                        </div>
                    }
                }
            </div>
            <div class="logo-column logo-column-down">
                @if (companies != null && companies.Any())
                {
                    @foreach (var company in companies.AsEnumerable().Reverse())
                    {
                        <div class="logo-card">
                            @if (!string.IsNullOrEmpty(company.LogoUrl))
                            {
                                <img src="@company.LogoUrl" alt="@company.Name" />
                            }
                            else
                            {
                                <span class="company-name-fallback">@company.Name</span>
                            }
                        </div>
                    }
                    @foreach (var company in companies.AsEnumerable().Reverse())
                    {
                        <div class="logo-card">
                            @if (!string.IsNullOrEmpty(company.LogoUrl))
                            {
                                <img src="@company.LogoUrl" alt="@company.Name" />
                            }
                            else
                            {
                                <span class="company-name-fallback">@company.Name</span>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</section>

@{
    var reviews = ViewBag.Reviews as List<MeetSpot.Web.Services.ReviewResponseDto>;
}
<section class="testimonials">
    <div class="section-header centered">
        <h2>What people say</h2>
        <p class="section-subtitle">Real feedback from teams using MeetSpot every day</p>
    </div>

    <div class="testimonials-grid">
        @if (reviews != null && reviews.Any())
        {
            @foreach (var review in reviews)
            {
                var initials = $"{review.UserFirstName.FirstOrDefault()}{review.UserLastName.FirstOrDefault()}".ToUpper();
                <div class="testimonial-card">
                    <p class="testimonial-text">"@review.Text"</p>
                    <div class="testimonial-author">
                        <div class="author-avatar">@initials</div>
                        <div class="author-info">
                            <span class="author-name">@review.UserFirstName @review.UserLastName</span>
                            <span class="author-role">@(review.CompanyDomain ?? "MeetSpot user")</span>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="empty-state">No reviews yet. Be the first to share your experience!</p>
        }
    </div>
</section>
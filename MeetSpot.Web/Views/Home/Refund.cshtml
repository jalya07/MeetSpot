@{ViewData["Title"] = "Refund Policy";}
<section class="blog-hero">
    <div class="blog-hero-content">
        <span class="hero-eyebrow" style="color:var(--color-coral);">Legal</span>
        <h1>Refund Policy</h1>
        <p>Last updated: July 2026</p>
    </div>
</section>
<section class="blog-section">
    <div class="blog-inner" style="max-width:800px;">
        <h2 style="font-size:20px;font-weight:600;color:var(--color-ink);margin-bottom:12px;">Balance Refunds</h2>
        <p style="color:var(--color-text-muted);margin-bottom:20px;line-height:1.7;">Funds added to your MeetSpot balance are non-refundable. However, your balance will remain available for future bookings and does not expire.</p>

        <h2 style="font-size:20px;font-weight:600;color:var(--color-ink);margin-bottom:12px;">Booking Cancellations</h2>
        <p style="color:var(--color-text-muted);margin-bottom:20px;line-height:1.7;">When you cancel a booking, the refund amount depends on your account type and cancellation timing:</p>
        <ul style="color:var(--color-text-muted);margin-bottom:20px;line-height:1.7;list-style:disc;padding-left:20px;">
            <li style="margin-bottom:8px;"><strong>Regular accounts:</strong> Full refund if cancelled 4+ hours before. 50% refund if cancelled less than 4 hours before.</li>
            <li style="margin-bottom:8px;"><strong>Premium accounts:</strong> Full refund if cancelled 2+ hours before. 75% refund if cancelled less than 2 hours before.</li>
            <li style="margin-bottom:8px;"><strong>Corporate accounts:</strong> Full refund at any time, no cancellation fee.</li>
        </ul>

        <h2 style="font-size:20px;font-weight:600;color:var(--color-ink);margin-bottom:12px;">Subscription Refunds</h2>
        <p style="color:var(--color-text-muted);margin-bottom:20px;line-height:1.7;">Subscription fees are non-refundable. When you cancel a subscription, you retain Premium access until the end of the current billing period.</p>

        <h2 style="font-size:20px;font-weight:600;color:var(--color-ink);margin-bottom:12px;">Contact Us</h2>
        <p style="color:var(--color-text-muted);margin-bottom:20px;line-height:1.7;">If you have questions about refunds, please contact us at <a href="/Home/Contact" style="color:var(--color-coral);">our contact page</a>.</p>
    </div>
</section>
@{ViewData["Title"] = "Privacy Policy";}
<section class="blog-hero">
    <div class="blog-hero-content">
        <span class="hero-eyebrow" style="color:var(--color-coral);">Legal</span>
        <h1>Privacy Policy</h1>
        <p>Last updated: July 2026</p>
    </div>
</section>
<section class="blog-section">
    <div class="blog-inner" style="max-width:800px;">
        <h2 style="font-size:20px;font-weight:600;color:var(--color-ink);margin-bottom:12px;">Information We Collect</h2>
        <p style="color:var(--color-text-muted);margin-bottom:20px;line-height:1.7;">We collect information you provide when registering: name, email address, and account type. We also collect booking history and transaction data to provide our service.</p>

        <h2 style="font-size:20px;font-weight:600;color:var(--color-ink);margin-bottom:12px;">How We Use Your Information</h2>
        <p style="color:var(--color-text-muted);margin-bottom:20px;line-height:1.7;">We use your information to provide and improve MeetSpot services, process bookings and payments, send booking confirmations and 2FA codes, and communicate service updates.</p>

        <h2 style="font-size:20px;font-weight:600;color:var(--color-ink);margin-bottom:12px;">Data Security</h2>
        <p style="color:var(--color-text-muted);margin-bottom:20px;line-height:1.7;">We implement industry-standard security measures including password hashing (BCrypt), JWT authentication, and HTTPS encryption to protect your data.</p>

        <h2 style="font-size:20px;font-weight:600;color:var(--color-ink);margin-bottom:12px;">Cookies</h2>
        <p style="color:var(--color-text-muted);margin-bottom:20px;line-height:1.7;">We use HTTP-only cookies to store authentication tokens (AccessToken, RefreshToken). These cookies are essential for the service to function and cannot be disabled.</p>

        <h2 style="font-size:20px;font-weight:600;color:var(--color-ink);margin-bottom:12px;">Contact</h2>
        <p style="color:var(--color-text-muted);margin-bottom:20px;line-height:1.7;">For privacy concerns, contact us at <a href="/Home/Contact" style="color:var(--color-coral);">our contact page</a>.</p>
    </div>
</section>

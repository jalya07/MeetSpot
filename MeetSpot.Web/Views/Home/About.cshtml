@{
    ViewData["Title"] = "About MeetSpot";
}

<section class="about-hero">
    <div class="about-hero-content">
        <span class="hero-eyebrow" style="color: var(--color-coral);">Our story</span>
        <h1>Built for teams who value their time</h1>
        <p>MeetSpot started with a simple frustration — too much time wasted finding and booking meeting rooms. We built the solution we wished existed.</p>
    </div>
</section>

<section class="about-mission">
    <div class="about-mission-inner">
        <div class="about-mission-text">
            <h2>Our mission</h2>
            <p>We believe that great work happens when teams can focus on what matters — not on logistics. MeetSpot removes the friction from reserving meeting spaces so your team can spend more time doing, less time coordinating.</p>
            <p>From a quick 1-on-1 to a full-day workshop, MeetSpot adapts to every kind of meeting — with instant booking, QR check-in, and real-time availability.</p>
        </div>
        <div class="about-stats">
            <div class="about-stat">
                <span class="about-stat-number">500+</span>
                <span class="about-stat-label">Bookings made</span>
            </div>
            <div class="about-stat">
                <span class="about-stat-number">13</span>
                <span class="about-stat-label">Meeting rooms</span>
            </div>
            <div class="about-stat">
                <span class="about-stat-number">6</span>
                <span class="about-stat-label">Partner companies</span>
            </div>
            <div class="about-stat">
                <span class="about-stat-number">99%</span>
                <span class="about-stat-label">Uptime</span>
            </div>
        </div>
    </div>
</section>

<section class="about-values">
    <div class="about-values-inner">
        <h2>What drives us</h2>
        <div class="values-grid">
            <div class="value-card">
                <span class="value-icon">⚡</span>
                <h3>Speed</h3>
                <p>Booking a room should take seconds, not minutes. We obsess over making every interaction fast and frictionless.</p>
            </div>
            <div class="value-card">
                <span class="value-icon">🔒</span>
                <h3>Reliability</h3>
                <p>No double bookings, no surprises. MeetSpot guarantees your room will be ready when you arrive.</p>
            </div>
            <div class="value-card">
                <span class="value-icon">🤝</span>
                <h3>Flexibility</h3>
                <p>Whether you're a solo user or a large corporation, MeetSpot adapts to your needs with the right plan.</p>
            </div>
            <div class="value-card">
                <span class="value-icon">📊</span>
                <h3>Transparency</h3>
                <p>Clear pricing, clear policies. No hidden fees, no surprises on your bill — ever.</p>
            </div>
        </div>
    </div>
</section>

<section class="footer-cta">
    <div class="footer-cta-content">
        <h2>Ready to get started?</h2>
        <p>Join teams already using MeetSpot to run better meetings.</p>
        <div class="hero-actions" style="justify-content: center;">
            <a href="/Account/Register" class="btn btn-primary">Create free account</a>
            <a href="/Room" class="btn btn-secondary">Browse rooms</a>
        </div>
    </div>
</section>
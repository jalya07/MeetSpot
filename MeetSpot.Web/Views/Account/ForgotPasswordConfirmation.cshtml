@{
    ViewData["Title"] = "Check your email";
}

<section class="auth-section">
    <div class="auth-card">
        <div class="auth-header">
            <h1>Check your email</h1>
            <p>If an account exists with that email, we've sent a password reset link.</p>
        </div>

        <div class="auth-success">
            <p>The link expires in 1 hour. Check your spam folder if you don't see it.</p>
        </div>

        <p class="auth-switch" style="margin-top: 24px;"><a href="/Account/Login">Back to login</a></p>
    </div>
</section>
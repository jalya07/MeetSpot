@model List<MeetSpot.Web.Services.UserProfileDto>
@{
    ViewData["Title"] = "Admin — Users";
    var regularUsers = Model.Where(u => u.UserType == "Regular").ToList();
    var premiumUsers = Model.Where(u => u.UserType == "Premium").ToList();
    var corporateUsers = Model.Where(u => u.UserType == "Corporate").ToList();
}

<section class="admin-section">
    <div class="admin-inner">
        <aside class="admin-sidebar">
            <h3 class="admin-sidebar-title">Admin Panel</h3>
            <nav class="admin-nav">
                <a href="/Admin/Dashboard" class="admin-nav-link"> <i class="fas fa-chart-line"></i> Dashboard</a>
                <a href="/Admin/Rooms" class="admin-nav-link"> <i class="fas fa-building"></i> Rooms</a>
                <a href="/Admin/Bookings" class="admin-nav-link"> <i class="fas fa-calendar-alt"></i> Bookings</a>
                <a href="/Admin/Users" class="admin-nav-link active"> <i class="fas fa-users"></i> Users</a>
                <a href="/Admin/Reviews" class="admin-nav-link"> <i class="fas fa-star"></i> Reviews</a>
                <a href="/Admin/HeroSlides" class="admin-nav-link"><i class="fas fa-images"></i> Hero Slides</a>
                <a href="/Admin/Messages" class="admin-nav-link"><i class="fas fa-envelope"></i> Messages</a>
                <a href="/Admin/Blog" class="admin-nav-link"><i class="fas fa-blog"></i> Blog</a>
                <a href="/Admin/Companies" class="admin-nav-link"><i class="fas fa-building"></i> Companies</a>
                <a href="/Admin/CompanyRequests" class="admin-nav-link"><i class="fas fa-handshake"></i> Company Requests</a>
                <a href="/Admin/Promotions" class="admin-nav-link"><i class="fas fa-tag"></i> Promotions</a>
            </nav>
        </aside>

        <div class="admin-content">
            <h1>Users (@Model.Count)</h1>

            <div class="admin-stats-grid" style="margin-bottom: 32px;">
                <div class="admin-stat-card">
                    <span class="admin-stat-icon"><i class="fas fa-user"></i></span>
                    <div>
                        <p class="admin-stat-number">@regularUsers.Count</p>
                        <p class="admin-stat-label">Regular</p>
                    </div>
                </div>
                <div class="admin-stat-card">
                    <span class="admin-stat-icon"><i class="fas fa-star"></i></span>
                    <div>
                        <p class="admin-stat-number">@premiumUsers.Count</p>
                        <p class="admin-stat-label">Premium</p>
                    </div>
                </div>
                <div class="admin-stat-card">
                    <span class="admin-stat-icon"><i class="fas fa-building"></i></span>
                    <div>
                        <p class="admin-stat-number">@corporateUsers.Count</p>
                        <p class="admin-stat-label">Corporate</p>
                    </div>
                </div>
                <div class="admin-stat-card">
                    <span class="admin-stat-icon"><i class="fas fa-check"></i></span>
                    <div>
                        <p class="admin-stat-number">@Model.Count(u => u.IsActive)</p>
                        <p class="admin-stat-label">Active total</p>
                    </div>
                </div>
            </div>

            @if (corporateUsers.Any())
            {
                <h2><i class="fas fa-building"></i> Corporate users (@corporateUsers.Count)</h2>
                <div class="admin-table-wrap" style="margin-bottom: 28px;">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Company domain</th>
                                <th>Balance</th>
                                <th>Status</th>
                                <th>Joined</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in corporateUsers)
                            {
                                <tr>
                                    <td>
                                        <div style="display:flex;align-items:center;gap:10px;">
                                            @if (!string.IsNullOrEmpty(user.AvatarUrl))
                                            {
                                                <img src="@user.AvatarUrl" alt="@user.FullName"
                                                    style="width:32px;height:32px;border-radius:50%;object-fit:cover;" />
                                            }
                                            else
                                            {
                                                <div style="width:32px;height:32px;border-radius:50%;background:#1b2b4d;color:white;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;">
                                                    @user.FullName.FirstOrDefault()
                                                </div>
                                            }
                                            <strong>@user.FullName</strong>
                                        </div>
                                    </td>
                                    <td style="color:#6b7280;">@user.Email</td>
                                    <td><span class="admin-badge admin-badge-blue">@(user.Email.Split('@').LastOrDefault())</span></td>
                                    <td>$@user.Balance.ToString("F2")</td>
                                    <td><span class="admin-badge @(user.IsActive ? "admin-badge-green" : "admin-badge-red")">@(user.IsActive ? "Active" : "Blocked")</span></td>
                                    <td style="color:#6b7280;font-size:13px;">@user.CreatedAt.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (premiumUsers.Any())
            {
                <h2><i class="fas fa-star"></i> Premium users (@premiumUsers.Count)</h2>
                <div class="admin-table-wrap" style="margin-bottom: 28px;">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Balance</th>
                                <th>Status</th>
                                <th>Joined</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in premiumUsers)
                            {
                                <tr>
                                    <td>
                                        <div style="display:flex;align-items:center;gap:10px;">
                                            @if (!string.IsNullOrEmpty(user.AvatarUrl))
                                            {
                                                <img src="@user.AvatarUrl" alt="@user.FullName"
                                                    style="width:32px;height:32px;border-radius:50%;object-fit:cover;" />
                                            }
                                            else
                                            {
                                                <div style="width:32px;height:32px;border-radius:50%;background:#1b2b4d;color:white;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;">
                                                    @user.FullName.FirstOrDefault()
                                                </div>
                                            }
                                            <strong>@user.FullName</strong>
                                        </div>
                                    </td>
                                    <td style="color:#6b7280;">@user.Email</td>
                                    <td>$@user.Balance.ToString("F2")</td>
                                    <td><span class="admin-badge admin-badge-blue">@(user.Email.Split('@').LastOrDefault())</span></td>
                                    <td style="color:#6b7280;font-size:13px;">@user.CreatedAt.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (regularUsers.Any())
            {
                <h2><i class="fas fa-user"></i> Regular users (@regularUsers.Count)</h2>
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Balance</th>
                                <th>Status</th>
                                <th>Joined</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in regularUsers)
                            {
                                <tr>
                                    <td>
                                        <div style="display:flex;align-items:center;gap:10px;">
                                            @if (!string.IsNullOrEmpty(user.AvatarUrl))
                                            {
                                                <img src="@user.AvatarUrl" alt="@user.FullName"
                                                    style="width:32px;height:32px;border-radius:50%;object-fit:cover;" />
                                            }
                                            else
                                            {
                                                <div style="width:32px;height:32px;border-radius:50%;background:#1b2b4d;color:white;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;">
                                                    @user.FullName.FirstOrDefault()
                                                </div>
                                            }
                                            <strong>@user.FullName</strong>
                                        </div>
                                    </td>
                                    <td style="color:#6b7280;">@user.Email</td>
                                    <td>$@user.Balance.ToString("F2")</td>
                                    <td><span class="admin-badge @(user.IsActive ? "admin-badge-green" : "admin-badge-red")">@(user.IsActive ? "Active" : "Blocked")</span></td>
                                    <td style="color:#6b7280;font-size:13px;">@user.CreatedAt.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</section>
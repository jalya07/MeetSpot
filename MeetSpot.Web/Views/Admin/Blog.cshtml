@model List<MeetSpot.Web.Services.BlogPostDto>
@{
    ViewData["Title"] = "Admin — Blog";
}

<section class="admin-section">
    <div class="admin-inner">
        <aside class="admin-sidebar">
            <h3 class="admin-sidebar-title">Admin Panel</h3>
            <nav class="admin-nav">
                <a href="/Admin/Dashboard" class="admin-nav-link"><i class="fas fa-chart-line"></i> Dashboard</a>
                <a href="/Admin/Rooms" class="admin-nav-link"><i class="fas fa-building"></i> Rooms</a>
                <a href="/Admin/Bookings" class="admin-nav-link"><i class="fas fa-calendar-alt"></i> Bookings</a>
                <a href="/Admin/Users" class="admin-nav-link"><i class="fas fa-users"></i> Users</a>
                <a href="/Admin/Reviews" class="admin-nav-link"><i class="fas fa-star"></i> Reviews</a>
                <a href="/Admin/HeroSlides" class="admin-nav-link"><i class="fas fa-images"></i> Hero Slides</a>
                <a href="/Admin/Messages" class="admin-nav-link"><i class="fas fa-envelope"></i> Messages</a>
                <a href="/Admin/Blog" class="admin-nav-link active"><i class="fas fa-blog"></i> Blog</a>
                <a href="/Admin/Companies" class="admin-nav-link"><i class="fas fa-building"></i> Companies</a>
            </nav>
        </aside>

        <div class="admin-content">
            <div class="admin-table-header">
                <h2>Blog Posts (@Model.Count)</h2>
                <a href="/Admin/CreatePost" class="btn btn-primary admin-action-btn">+ New post</a>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="auth-success" style="margin-bottom:16px;"><p>@TempData["Success"]</p></div>
            }

            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var post in Model.OrderByDescending(p => p.CreatedAt))
                        {
                            <tr>
                                <td><strong>@post.Title</strong></td>
                                <td style="color:#6b7280;">@post.AuthorName</td>
                                <td>
                                    <span class="admin-badge @(post.IsPublished ? "admin-badge-green" : "admin-badge-gray")">
                                        @(post.IsPublished ? "Published" : "Draft")
                                    </span>
                                </td>
                                <td style="color:#6b7280;font-size:13px;">@post.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td>
                                    <div style="display:flex;gap:8px;align-items:center;">
                                        <a href="/Blog/Details/@post.Id" class="admin-action-btn admin-action-btn-primary">View</a>
                                        <a href="/Admin/EditPost/@post.Id" class="admin-action-btn" 
                                            style="background:#dbeafe;color:#2563eb;">Edit</a>
                                        <button type="button" class="admin-action-btn admin-action-btn-danger"
                                                onclick="openDeleteModal('/Admin/DeletePost/@post.Id')">Delete</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<div id="deleteModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;">
    <div style="background:white;border-radius:16px;padding:32px;max-width:400px;width:90%;text-align:center;">
        <div style="font-size:48px;margin-bottom:16px;"><i class="fas fa-trash"></i></div>
        <h3 style="font-size:20px;font-weight:600;color:#1b2b4d;margin-bottom:8px;">Delete post?</h3>
        <p style="color:#6b7280;font-size:14px;margin-bottom:24px;">This action cannot be undone.</p>
        <div style="display:flex;gap:12px;justify-content:center;">
            <button onclick="closeDeleteModal()" style="padding:12px 24px;border-radius:8px;border:1px solid #e5e2dc;background:white;font-size:14px;cursor:pointer;">Cancel</button>
            <form id="deleteForm" method="post" style="display:inline;">
                <button type="submit" style="padding:12px 24px;border-radius:8px;border:none;background:#dc2626;color:white;font-size:14px;cursor:pointer;">Delete</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openDeleteModal(action) {
        document.getElementById('deleteForm').action = action;
        document.getElementById('deleteModal').style.display = 'flex';
    }
    function closeDeleteModal() {
        document.getElementById('deleteModal').style.display = 'none';
    }
</script>
}
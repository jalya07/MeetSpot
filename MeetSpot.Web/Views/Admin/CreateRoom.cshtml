@{
    ViewData["Title"] = "Create Room";
}
@if (TempData["Debug"] != null)
{
    <p>@TempData["Debug"]</p>
}

<section class="admin-section">
    <div class="admin-inner">
        <aside class="admin-sidebar">
            <h3 class="admin-sidebar-title">Admin Panel</h3>
            <nav class="admin-nav">
                <a href="/Admin/Dashboard" class="admin-nav-link"><i class="fas fa-chart-line"></i> Dashboard</a>
                <a href="/Admin/Rooms" class="admin-nav-link active"><i class="fas fa-building"></i> Rooms</a>
                <a href="/Admin/Bookings" class="admin-nav-link"><i class="fas fa-calendar-alt"></i> Bookings</a>
                <a href="/Admin/Users" class="admin-nav-link"><i class="fas fa-users"></i> Users</a>
                <a href="/Admin/Reviews" class="admin-nav-link"><i class="fas fa-star"></i> Reviews</a>
                <a href="/Admin/HeroSlides" class="admin-nav-link"><i class="fas fa-images"></i> Hero Slides</a>
                <a href="/Admin/Messages" class="admin-nav-link"><i class="fas fa-envelope"></i> Messages</a>
                <a href="/Admin/Blog" class="admin-nav-link"><i class="fas fa-blog"></i> Blog</a>
            </nav>
        </aside>

        <div class="admin-content">
            <h1>Create New Room</h1>

            <div style="background:var(--color-white);border:1px solid var(--color-border);border-radius:14px;padding:32px;max-width:700px;">
                <form asp-action="CreateRoom" method="post" enctype="multipart/form-data" class="auth-form">

                    <div class="form-row">
                        <div class="form-group">
                            <label>Room name</label>
                            <input type="text" name="name" placeholder="e.g. Skyline Conference Room" required />
                        </div>
                        <div class="form-group">
                            <label>Type</label>
                            <select name="type">
                                <option value="Standard">Standard</option>
                                <option value="Vip">VIP</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Description</label>
                        <textarea name="description" rows="3" placeholder="Describe the room..."
                                  style="padding:12px;border:1px solid var(--color-border);border-radius:8px;font-size:14px;font-family:inherit;width:100%;resize:vertical;box-sizing:border-box;"></textarea>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Floor</label>
                            <input type="number" name="floor" min="1" required />
                        </div>
                        <div class="form-group">
                            <label>Capacity</label>
                            <input type="number" name="capacity" min="1" required />
                        </div>
                        <div class="form-group">
                            <label>Price per hour ($)</label>
                            <input type="number" name="pricePerHour" step="0.01" min="0" required />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Room photo 1 (main)</label>
                        <input type="file" name="imageFiles" accept="image/*"
                            style="padding:10px;border:1px solid var(--color-border);border-radius:8px;width:100%;box-sizing:border-box;" />
                    </div>
                    <div class="form-group">
                        <label>Room photo 2</label>
                        <input type="file" name="imageFiles" accept="image/*"
                            style="padding:10px;border:1px solid var(--color-border);border-radius:8px;width:100%;box-sizing:border-box;" />
                    </div>
                    <div class="form-group">
                        <label>Room photo 3</label>
                        <input type="file" name="imageFiles" accept="image/*"
                            style="padding:10px;border:1px solid var(--color-border);border-radius:8px;width:100%;box-sizing:border-box;" />
                    </div>

                    <div id="imagePreviewGrid" style="display:none; grid-template-columns: repeat(3,1fr); gap:10px; margin-top:12px;"></div>

                    <div style="display:flex; gap:12px; margin-top:8px;">
                        <button type="submit" class="btn btn-primary">Create room</button>
                        <a href="/Admin/Rooms" class="btn btn-secondary"
                           style="border:1px solid var(--color-border);color:var(--color-ink);">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
<script>
    document.querySelector('[name="imageFiles"]').addEventListener('change', function(e) {
        const grid = document.getElementById('imagePreviewGrid');
        grid.innerHTML = '';
        grid.style.display = 'grid';

        Array.from(e.target.files).forEach(file => {
            const reader = new FileReader();
            reader.onload = function(ev) {
                const img = document.createElement('img');
                img.src = ev.target.result;
                img.style.cssText = 'width:100%;height:100px;object-fit:cover;border-radius:8px;';
                grid.appendChild(img);
            };
            reader.readAsDataURL(file);
        });
    });
</script>
}
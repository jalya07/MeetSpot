@model MeetSpot.Web.Services.HeroSlideDto
@{
    ViewData["Title"] = "Edit Slide";
}

<section class="admin-section">
    <div class="admin-inner">
        <aside class="admin-sidebar">
            <h3 class="admin-sidebar-title">Admin Panel</h3>
            <nav class="admin-nav">
                <a href="/Admin/Dashboard" class="admin-nav-link"><i class="fas fa-chart-line"></i> Dashboard</a>
                <a href="/Admin/Rooms" class="admin-nav-link"><i class="fas fa-building"></i> Rooms</a>
                <a href="/Admin/Bookings" class="admin-nav-link"><i class="fas fa-calendar-alt"></i> Bookings</a>
                <a href="/Admin/Users" class="admin-nav-link"><i class="fas fa-users"></i> Users</a>
                <a href="/Admin/Reviews" class="admin-nav-link"><i class="fas fa-star"></i> Reviews</a>
                <a href="/Admin/HeroSlides" class="admin-nav-link active"><i class="fas fa-images"></i> Hero Slides</a>
                <a href="/Admin/Messages" class="admin-nav-link"><i class="fas fa-envelope"></i> Messages</a>
                <a href="/Admin/Blog" class="admin-nav-link"><i class="fas fa-blog"></i> Blog</a>
            </nav>
        </aside>

        <div class="admin-content">
            <h1>Edit Slide #@Model.Id</h1>

            @if (TempData["Error"] != null)
            {
                <div class="auth-errors" style="margin-bottom:16px;">
                    <p>@TempData["Error"]</p>
                </div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="auth-success" style="margin-bottom:16px;">
                    <p>@TempData["Success"]</p>
                </div>
            }

            <div style="background:var(--color-white);border:1px solid var(--color-border);border-radius:14px;padding:32px;max-width:600px;">
                
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div style="margin-bottom:20px;">
                        <img src="@Model.ImageUrl" alt="Current slide" 
                             style="width:100%;height:200px;object-fit:cover;border-radius:10px;" />
                    </div>
                }

                
                <form asp-action="EditSlide" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="auth-form">
                     <div class="form-group">
                        <label>Upload new image (optional)</label>
                        <input type="file" name="imageFile" accept="image/*"
                                style="padding:10px;border:1px solid var(--color-border);border-radius:8px;width:100%;box-sizing:border-box;" />
                            <span class="form-hint">JPG, PNG or WEBP only. Leave empty to keep current image.</span>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Display order</label>
                            <input type="number" name="displayOrder" value="@Model.DisplayOrder" min="1" required />
                        </div>
                        <div class="form-group">
                            <label>Caption</label>
                            <input type="text" name="caption" value="@Model.Caption" placeholder="Optional" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label style="display:flex;align-items:center;gap:10px;cursor:pointer;">
                            <input type="checkbox" name="isActive" value="true" @(Model.IsActive ? "checked" : "") />
                            Active (show on homepage)
                        </label>
                    </div>

                    <div style="display:flex;gap:12px;margin-top:8px;">
                        <button type="submit" class="btn btn-primary">Save changes</button>
                        <a href="/Admin/HeroSlides" class="btn btn-secondary" 
                           style="border:1px solid var(--color-border);color:var(--color-ink);">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
@model MeetSpot.Web.Services.RoomResponseDto
@{
    ViewData["Title"] = "Edit Room";
}

<section class="admin-section">
    <div class="admin-inner">
        <aside class="admin-sidebar">
            <h3 class="admin-sidebar-title">Admin Panel</h3>
            <nav class="admin-nav">
                <a href="/Admin/Dashboard" class="admin-nav-link"><i class="fas fa-chart-line"></i> Dashboard</a>
                <a href="/Admin/Rooms" class="admin-nav-link active"><i class="fas fa-building"></i> Rooms</a>
                <a href="/Admin/Bookings" class="admin-nav-link"><i class="fas fa-calendar-alt"></i> Bookings</a>
                <a href="/Admin/Users" class="admin-nav-link"><i class="fas fa-users"></i> Users</a>
                <a href="/Admin/Reviews" class="admin-nav-link"><i class="fas fa-star"></i> Reviews</a>
                <a href="/Admin/HeroSlides" class="admin-nav-link"><i class="fas fa-images"></i> Hero Slides</a>
                <a href="/Admin/Messages" class="admin-nav-link"><i class="fas fa-envelope"></i> Messages</a>
                <a href="/Admin/Blog" class="admin-nav-link"><i class="fas fa-blog"></i> Blog</a>
            </nav>
        </aside>

        <div class="admin-content">
            <h1>Edit Room — @Model.Name</h1>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="auth-success" style="margin-bottom:16px;">
                    <p>@TempData["SuccessMessage"]</p>
                </div>
            }

            <div style="background:var(--color-white);border:1px solid var(--color-border);border-radius:14px;padding:32px;max-width:600px;">
                <form asp-action="EditRoom" asp-route-id="@Model.Id" method="post"
                      enctype="multipart/form-data" class="auth-form">

                    <div class="form-group">
                        <label>Room name</label>
                        <input type="text" name="name" value="@Model.Name" required />
                    </div>

                    <div class="form-group">
                        <label>Description</label>
                        <input type="text" name="description" value="@Model.Description" />
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Floor</label>
                            <input type="number" name="floor" value="@Model.Floor" required />
                        </div>
                        <div class="form-group">
                            <label>Capacity</label>
                            <input type="number" name="capacity" value="@Model.Capacity" required />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Price per hour ($)</label>
                            <input type="number" name="pricePerHour" value="@Model.PricePerHour" step="0.01" required />
                        </div>
                        <div class="form-group">
                            <label>Type</label>
                            <select name="type">
                                <option value="Standard" selected="@(Model.Type == "Standard")">Standard</option>
                                <option value="Vip" selected="@(Model.Type == "Vip")">VIP</option>
                            </select>
                        </div>
                    </div>

                    @if (Model.ImageUrls.Any())
                    {
                        <div class="form-group">
                            <label>Current photos</label>
                            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:8px;">
                                @foreach (var url in Model.ImageUrls)
                                {
                                    <img src="@url" alt="Room photo"
                                         style="width:100%;height:100px;object-fit:cover;border-radius:8px;border:1px solid var(--color-border);" />
                                }
                            </div>
                            <p style="font-size:13px;color:var(--color-text-muted);">Upload new photos below to replace</p>
                        </div>
                    }

                    <div class="form-group">
                        <label>New photo 1</label>
                        <input type="file" name="imageFiles" accept="image/*"
                               style="padding:10px;border:1px solid var(--color-border);border-radius:8px;width:100%;box-sizing:border-box;" />
                    </div>
                    <div class="form-group">
                        <label>New photo 2</label>
                        <input type="file" name="imageFiles" accept="image/*"
                               style="padding:10px;border:1px solid var(--color-border);border-radius:8px;width:100%;box-sizing:border-box;" />
                    </div>
                    <div class="form-group">
                        <label>New photo 3</label>
                        <input type="file" name="imageFiles" accept="image/*"
                               style="padding:10px;border:1px solid var(--color-border);border-radius:8px;width:100%;box-sizing:border-box;" />
                    </div>

                    <div style="display:flex;gap:12px;margin-top:8px;">
                        <button type="submit" class="btn btn-primary">Save changes</button>
                        <a href="/Admin/Rooms" class="btn btn-secondary"
                           style="border:1px solid var(--color-border);color:var(--color-ink);">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
@model List<MeetSpot.Web.Services.HeroSlideDto>
@{
    ViewData["Title"] = "Admin — Hero Slides";
}
@if (TempData["Error"] != null)
{
    <div class="auth-errors"><p>@TempData["Error"]</p></div>
}
@if (TempData["Success"] != null)
{
    <div class="auth-success"><p>@TempData["Success"]</p></div>
}

<section class="admin-section">
    <div class="admin-inner">
        <aside class="admin-sidebar">
            <h3 class="admin-sidebar-title">Admin Panel</h3>
            <nav class="admin-nav">
                <a href="/Admin/Dashboard" class="admin-nav-link"><i class="fas fa-chart-line"></i> Dashboard</a>
                <a href="/Admin/Rooms" class="admin-nav-link"><i class="fas fa-building"></i> Rooms</a>
                <a href="/Admin/Bookings" class="admin-nav-link"><i class="fas fa-calendar-alt"></i> Bookings</a>
                <a href="/Admin/Users" class="admin-nav-link"><i class="fas fa-users"></i> Users</a>
                <a href="/Admin/Reviews" class="admin-nav-link"><i class="fas fa-star"></i> Reviews</a>
                <a href="/Admin/HeroSlides" class="admin-nav-link active"><i class="fas fa-images"></i> Hero Slides</a>
            </nav>
        </aside>

        <div class="admin-content">
            <h1>Hero Slides</h1>

            <div style="background:var(--color-white);border:1px solid var(--color-border);border-radius:14px;padding:28px;margin-bottom:28px;">
                <h2 style="margin-top:0;">Add new slide</h2>
                <form method="post" action="/Admin/AddSlide" enctype="multipart/form-data" class="auth-form">
                    <div class="form-group">
                        <label>Upload image</label>
                        <input type="file" name="imageFile" accept="image/*" required
                               style="padding:10px;border:1px solid var(--color-border);border-radius:8px;width:100%;" />
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Display order</label>
                            <input type="number" name="displayOrder" value="@(Model.Count + 1)" min="1" required />
                        </div>
                        <div class="form-group">
                            <label>Caption (optional)</label>
                            <input type="text" name="caption" placeholder="e.g. Modern conference rooms" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">Upload & add slide</button>
                </form>
            </div>

            <div class="admin-table-wrap">
                <div class="admin-table-header">
                    <h2>Current slides (@Model.Count)</h2>
                </div>
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Preview</th>
                            <th>Image URL</th>
                            <th>Order</th>
                            <th>Caption</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var slide in Model.OrderBy(s => s.DisplayOrder))
                        {
                            <tr>
                                <td>
                                    <img src="@slide.ImageUrl" style="width:80px;height:50px;object-fit:cover;border-radius:6px;" />
                                </td>
                                <td style="font-size:13px;color:#6b7280;max-width:200px;overflow:hidden;text-overflow:ellipsis;">@slide.ImageUrl</td>
                                <td>@slide.DisplayOrder</td>
                                <td style="color:#6b7280;">@(slide.Caption ?? "—")</td>
                                <td>
                                    <span class="admin-badge @(slide.IsActive ? "admin-badge-green" : "admin-badge-red")">
                                        @(slide.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>
                                    <form method="post" action="/Admin/DeleteSlide/@slide.Id" style="display:inline;">
                                        <button type="submit" class="admin-action-btn admin-action-btn-danger"
                                                onclick="return confirm('Delete this slide?')">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
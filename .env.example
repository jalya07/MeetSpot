# MeetSpot production environment template
# Copy to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# Domain
# The public hostname Caddy serves and requests TLS for. Without your own
# domain, use an sslip.io host encoding your server's PUBLIC IP, e.g.
# 203.0.113.10.sslip.io  (resolves to 203.0.113.10). Reuse this value in the
# URLs below.
# ---------------------------------------------------------------------------
DOMAIN=YOUR_SERVER_IP.sslip.io

# Database
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=MeetSpotDb;User Id=sa;Password=YOUR_STRONG_PASSWORD;TrustServerCertificate=True;
SQL_SA_PASSWORD=YOUR_STRONG_PASSWORD

# JWT (shared by API and Web — the Web validates the token signature too)
Jwt__Key=YOUR_32+_CHARACTER_RANDOM_JWT_KEY
Jwt__Issuer=MeetSpot.API
Jwt__Audience=MeetSpot.Client
Jwt__ExpiresInMinutes=60

# Email (Gmail app password)
Email__Host=smtp.gmail.com
Email__Port=587
Email__SenderName=MeetSpot
Email__SenderEmail=your-email@gmail.com
Email__Password=YOUR_APP_PASSWORD

# Redis
Redis__ConnectionString=redis:6379

# Web / frontend — use https:// + your DOMAIN above
AppSettings__FrontendBaseUrl=https://YOUR_SERVER_IP.sslip.io
# Internal API base URL for server-side HTTP calls from the web container
ApiBaseUrl=http://api:8080/

# CORS origins (semicolon-separated) — use https:// + your DOMAIN above
Cors__Origins=https://YOUR_SERVER_IP.sslip.io

# Initial admin seed (only used when the database has no admin user)
AdminSeed__Email=admin@meetspot.example.com
AdminSeed__Password=CHANGE_THIS_STRONG_PASSWORD

# File uploads — shared volume mounted at /app/wwwroot/images in BOTH the API
# and Web containers. Uploaded images are served by the API under /images/*.
FileStorage__UploadsPath=/app/wwwroot/images
FileStorage__PublicBaseUrl=https://YOUR_SERVER_IP.sslip.io

# Features
# Only enable this in local dev; production needs a real payment provider.
Balance__EnableFakeTopUp=false

# Build artifacts — must be excluded so the container build does a clean
# restore/build instead of picking up stale local output.
**/bin/
**/obj/
**/out/

# Version control / IDE / OS cruft
.git/
.gitignore
.vs/
.vscode/
.idea/
*.user
.DS_Store

# Local environment & secrets (never bake these into an image)
.env
**/appsettings.Development.json

# Docs / compose / scripts not needed inside the image
README.md
docker-compose*.yml
Caddyfile
scripts/
backups/
